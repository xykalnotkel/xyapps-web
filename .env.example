# Salin file ini jadi .env lalu isi nilai aslinya.
# .env TIDAK pernah di-commit (sudah masuk .gitignore).

# Neon Postgres (pooler) — wajib sslmode=require.
# Jangan pakai parameter channel_binding: driver tidak mendukungnya.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Auth.js (menyusul saat auth asli dinyalakan)
# AUTH_SECRET=ganti-dengan-random-32-byte
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudinary — hosting media (icon app, screenshot, banner).
# Preset unsigned: upload langsung dari browser tanpa secret server.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hbhjusso
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=dykal_unsigned

# CATATAN: Cloudinary untuk MEDIA saja. File installer (AAB/APK)
# tetap lewat penyimpanan khusus (VPS/MinIO atau draft release) —
# Cloudinary berorientasi gambar/video, bukan distribusi APK.
